# CoreOS Assembler build outputs
/builds/
/builds.json
*.qcow2
*.iso
*.raw.xz
*.tar.gz

# COSA overrides (local build artifacts)
/overrides/

# coreos-assembler work directory (build/build.sh)
/.build/

# Design tokens staged into the image overlay by build/build.sh.
# Source of truth is design/dist/ -- never edit the staged copies.
/build/overlay.d/30-apexis/

# VM images
*.img
*.vmdk

# Signing keys — NEVER commit
*.key
*.pem
*.crt
osrelease.key
osrelease.pub

# Build logs
*.log

# Editor / OS cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python bytecode (design token generator)
__pycache__/
*.py[cod]